 "poems": [
  {
   "seq": "1",
   "text": "春日山春立くらしさをしかの朝行峯に霞たなひく",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "さをしかも子日やすらん春日野の小松か原にけさそむれ行",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "秋はをのか心にわきし鹿まても鶯の音に春を知らし",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "朝〓〓に霧わけなれしさをしかもかすめる空の春やさひしき",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "鹿の立とをちの野への柳かけなひくけしきも春そのとけき",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "いとはやもゝえ出にけりさをしかのあさる岡への春の早蕨",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "あつさ弓春の日あかぬ櫻かりわけ行末に鹿そおとろく",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "春雨に花ちる山のさをしかは木の葉しくれし秋や忘れぬ",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "若草を妻とやともにたのむらん駒にましれる春のさがしか",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "秋霧をまたわけてとや契るらむ鹿立峯にかへる鴈かね",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "をしか立山路の末に呼子鳥誰をよふとかさのみ啼らん",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "せきかくる苗代水に立しかはをのか影にや友をしるらん",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "さをしかもつねより野へやなつかしき菫花さく春の此頃",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "かきつはた花咲比はさは水の分行鹿も影そへたつる",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "[□]みぬたのみをかくる春日山鹿もあれぬか北の藤波",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "さをしかもいはてやおしむ春暮る名殘の色の山吹の花",
   "kana": "",
   "speaker": "爲兼〓鹿百首",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "鹿はかり野山をわくる身ともかなわかるゝ春をしたひ送らむ",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "衣手もうすきにうつる今よりや鹿も夏けにかへんとすらむ",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "山蔭や野へにつゝける道なれは卯花かけに鹿も立なり",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "秋山にすむやをしかも葵草かさすみあれのけふは知らん",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "郭公こゑをたつれて分ゆけはさき立鹿の跡そ殘れる",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "もろ人のあやめひくてふ沼水に鹿もけふこそおり立てけれ",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "早苗とるすそのゝ田子の聲〓〓におとろく鹿はみ山にそいる",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "五月やみ尾上にみゆる火のかけは山のさつおの鹿まつらしも",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "かほる香におのへの鹿も立そよるたち花にほふ山陰のやと",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "鹿のふす夏野の草の露まても螢のかけに光をそみる",
   "kana": "",
   "speaker": "",
   "page": 479,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "かやり火の烟はよはる夕暮の月出る峯に鹿の入ぬる",
   "kana": "",
   "speaker": "爲兼卿鹿百首",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "はちす葉も花さくほとに成にけりをしか妻こふ秋ちかゝらし",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "氷室山すゝしき陰とたのみてや木の下草に鹿もふすらん",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "やとにせく石まの水の涼しさに鹿もつねにそ立ならしける",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "御秡川夕なみかけて立風も鹿の啼へき秋いそく也",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "秋來ぬとけふゝく風にをしかふす野原の草も今や露けき",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "七夕もあふ夜になれはさをしかの妻戀すへき時は知らん",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "をきあかす白露おもみ小男鹿の分行野へに萩そかたよる",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "をのか妻おもひなしてや女郞花露けき野へに鹿は臥らん",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "をしかなく野への尾花の上よりもうれへの袖そ露はひまなき",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "露なから亂れそまさるさを鹿の鳴音もしけき野へのかるかや",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "小男鹿の妻とふ野邊の藤はかましほれて露のをかぬ日もなし",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "荻はらや秋に吹てふ風の夜に妻戀すらし鹿そなくなる",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "はつ鴈も今そ啼なるさをしかのしからむ萩の色かはるころ",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "三とせふる秋のうれへは春日野に音に鳴しかも思ひ知らむ",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "春日野の露も色そへわかうれへ鹿もあはれと思ひしるまて",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "鹿よりも音そなかれける三とせまて雲井へたつる秋霧の空",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "をしか立野原は庭もひとつにて垣ほにはへる朝かほの花",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "さをしかもむれて行也望月の駒ひきつゝくあふさかの道",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "鹿はかり鳴音あはれとみかさ山さしも曇らぬ月は知らん",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "なく鹿も砧の音も打たえてねられすなけく友と成ぬる",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "たゝに啼むしのねよりもさをしかの妻戀するそ思ひそふらん",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "さをしかも花にやめつる秋深き山路の菊の陰になく也",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "妻こひの鹿の音聞ゆ時雨ふる山の木の葉も色まさる比",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "此秋もまた暮はつる身のうさは鹿もともにそ音を啼にける",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "冬のきて木のは吹しく山陰に鹿も淚やもろく落そふ",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "むら時雨降まさる頃は山風も鹿の鳴音もひまなかりけり",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "さをしかのふす野の尾花末ふして霜置まさるけさの寒けさ",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "霰ちる野風はけしく小男鹿のをのかふしともふしうからまし",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "雪ふかきみ山の鹿も我はかりうつもれまさるものはおもはし",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "冬枯の澤へにたてるあしかもゝふしける鹿そ風におとろく",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "さほ川に千鳥しは鳴春日野の鹿もこよひの霜や寒けき",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "春日山やました水も氷る夜に鹿のうは毛も霜むすふらむ",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "さる澤の池邊に立るさをしかの影におとろく鴨のむら鳥",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "あしろ木によるてふ波の立居にも世を宇治山は鹿やすみうき",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "三笠山さよ更かたの神あそひ庭火のかけに鹿そ立よる",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "御狩野やとたちをあさるかり聲におとろく鹿そ立のきにける",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "さをしかの跡にまかせて炭竈の烟わけみるおほ原の山",
   "kana": "",
   "speaker": "爲兼卿鹿百首",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "今年さへさてや暮なん春日のゝ鹿もあはれをかけよと思ふに",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "こひそむる心よりしてさをしかの音に啼はかり思ふとはしれ",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "さを鹿は音に鳴頃も我はかり思ふ心を忍ひやはせん",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "鹿はかり聲にたつとも哀とはいもいはぬかも逢事なしに",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "をしかふす野原の秋の初尾花かはしそめても袖そ露けき",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "時しもあれ鹿も鳴なり衣〓〓になりわかれ行しのゝめの空",
   "kana": "",
   "speaker": "曳カ",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "又もやとたのみし中はむなしくて身を秋風に鹿も鳴なり",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "をしか啼たひれの野への露の床いも戀あかし夢もむすはす",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "音にたてゝ鳴やを鹿も我はかり思ふおもひはおよひしもせし",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "身をしれは哀そふかきさを鹿も心かよはぬ妻やこふらん",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "をしか啼野原のまくす秋風にうらみても猶あかぬ比哉",
   "kana": "",
   "speaker": "",
   "page": 480,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "身のうれへ心にあまる曉のねさめことゝふよその鹿のね",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "みかさ山神の惠を松かけに鹿よりもなを音はなかれけり",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "うきふしはなれもやしけきさゝ竹の夜をかさねても鹿の鳴覽",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "をくら山苔の岩かねふみならし鳴やをしかも世中やうき",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "春日野の鹿もあはれめ和哥の浦に道まとふ鶴の獨鳴音を",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "みかさ山神たにすつなさをしかの音に鳴よりも深きうれへを",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "袖ぬらすあはれは鹿も思ひしれたえて影見ぬさほ川の水",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "ふみわけし道たえはつる春日野に又もや聞んさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "鹿はかり通ひなれまし春日野にいかなる關そわか道もなき",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "はし姫も月に鳴音やかよふらん宇治のわたりのさをしかの聲",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "月にこく夜舟はるかに音すみて鹿のれおろす武庫の山風",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "鹿の音も草の枕もかなしきは都こひしき松風のよは",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "鹿の音もあはれとかなく古〓をわかるゝ跡のゑのゝめの空",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "松のかせ鹿の鳴音も聞わひぬ浮世におなし山かけの庵",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "世を秋に思ひ侘ぬる時しもあれ門田の面に鹿も鳴也",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "すみなれし雲井をこふる月の夜に哀をそへて鹿も鳴也",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "雲のうへに通ふとみつる夢たにも鹿の鳴音に又たえにけり",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "鹿のなく聲のうちにも常ならぬ世の〓とはりははなれさりけり",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "あやまらぬ身をやはすてんことはりを哀さためし春日のゝ鹿",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "みかさ山君のさかへを松風に鹿も千とせの聲かよふ也",
   "kana": "",
   "speaker": "",
   "page": 481,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
